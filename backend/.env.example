# Copy to `.env` for local development. Never commit real secrets.

# --- Environment ---
ENVIRONMENT=development

# --- Supabase (server-side only; service-role key never reaches the browser) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# HS256 secret used to verify Supabase access tokens locally (Settings -> API)
SUPABASE_JWT_SECRET=your-jwt-secret

# --- Model assets ---
# Defaults to <backend>/models when unset
#MODELS_DIR=./models

# --- Upload / image limits ---
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_PIXELS=40000000

# --- Storage ---
PREDICTION_BUCKET=prediction-images
SIGNED_URL_TTL_SECONDS=300

# --- CORS (comma separated origins for the Next.js dev server) ---
CORS_ORIGINS=http://localhost:3000,http://app.localhost:3000,http://lvh.me:3000,http://app.lvh.me:3000
